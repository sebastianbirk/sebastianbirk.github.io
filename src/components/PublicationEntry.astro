---
import { SELF, type Publication } from '../data/publications';

interface Props {
  pub: Publication;
  /** Compact form used on the homepage: no summary, no type badge. */
  compact?: boolean;
}

const { pub, compact = false } = Astro.props;

// Split the author string so the site owner's name can be emphasised
// without hand-marking it in every entry.
const authorParts = pub.authors.split(SELF);

const typeLabel: Record<Publication['type'], string> = {
  journal: 'Journal',
  preprint: 'Preprint',
  workshop: 'Workshop',
  abstract: 'Abstract',
};

const linkLabels: Record<string, string> = {
  doi: 'Journal',
  arxiv: 'arXiv',
  biorxiv: 'bioRxiv',
  pdf: 'PDF',
  code: 'Code',
  docs: 'Docs',
};

const links = Object.entries(pub.links ?? {}).filter(([, href]) => Boolean(href));
---

<article class:list={['pub', compact && 'pub--compact']}>
  <h3 class="pub__title">{pub.title}</h3>

  <p class="pub__authors">
    {
      authorParts.map((part, i) => (
        <>
          {i > 0 && <strong>{SELF}</strong>}
          {part}
        </>
      ))
    }
  </p>

  <p class="pub__venue">
    <span class="pub__venue-name">{pub.venue}</span>
    <span class="pub__year">{pub.date.slice(0, 4)}</span>
    {!compact && <span class="pub__badge">{typeLabel[pub.type]}</span>}
  </p>

  {!compact && pub.summary && <p class="pub__summary">{pub.summary}</p>}

  {
    links.length > 0 && (
      <p class="pub__links">
        {links.map(([key, href]) => (
          <a href={href}>{linkLabels[key] ?? key}</a>
        ))}
      </p>
    )
  }
</article>

<style>
  .pub {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .pub:last-child {
    border-bottom: 0;
  }

  .pub__title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.35rem;
  }

  .pub__authors {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .pub__authors strong {
    color: var(--text);
    font-weight: 600;
  }

  .pub__venue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.3rem;
    font-size: 0.875rem;
  }

  .pub__venue-name {
    font-style: italic;
    color: var(--text-muted);
  }

  .pub__year {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .pub__badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-subtle);
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
  }

  .pub__summary {
    margin-top: 0.55rem;
    font-size: 0.925rem;
    color: var(--text-muted);
    max-width: 44rem;
  }

  .pub__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.6rem;
  }

  .pub__links a {
    font-size: 0.825rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--accent-subtle);
  }

  .pub__links a:hover {
    border-bottom-color: currentColor;
  }

  .pub--compact {
    padding-block: 1rem;
  }
</style>
