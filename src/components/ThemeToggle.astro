---
// Light/dark switch. The no-flash script lives in BaseLayout's <head>;
// this component only renders the control and wires up the click handler.
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Switch between light and dark theme"
>
  <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 1.8v2.6M12 19.6v2.6M4.6 4.6l1.9 1.9M17.5 17.5l1.9 1.9M1.8 12h2.6M19.6 12h2.6M4.6 19.4l1.9-1.9M17.5 6.5l1.9-1.9"
    ></path>
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.5 14.6A8.7 8.7 0 0 1 9.4 3.5a8.7 8.7 0 1 0 11.1 11.1Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border);
  }

  .icon {
    grid-area: 1 / 1;
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the icon for the theme you would switch *to*. */
  .icon--sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon--sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon--moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon--sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon--moon {
      display: none;
    }
  }
</style>

<script>
  const button = document.getElementById('theme-toggle');

  button?.addEventListener('click', () => {
    const root = document.documentElement;
    // Resolve what is on screen right now, whether it came from an explicit
    // choice or from the OS preference.
    const current =
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';

    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be unavailable (private mode, blocked cookies). The
      // toggle still works for this page view.
    }
  });
</script>
