---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CellGraph from '../components/CellGraph.astro';
import { site, socials } from '../data/site';
import '../styles/global.css';

interface Props {
  /** Page title. The site name is appended automatically. */
  title?: string;
  description?: string;
  /** Widen the content column (used by Publications and Software). */
  wide?: boolean;
  /** Emitted as og:type; use "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search results and drop its canonical claim. */
  noindex?: boolean;
  /** Render the cell-graph wallpaper behind the page. */
  backdrop?: boolean;
}

const {
  title,
  description = site.description,
  wide = false,
  ogType = 'website',
  noindex = false,
  backdrop = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.titleTagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Structured data so search engines and Scholar-adjacent crawlers can connect
// this page to the same person as the linked profiles.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  affiliation: { '@type': 'Organization', name: site.affiliation },
  url: canonical.origin,
  email: `mailto:${site.email}`,
  sameAs: socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* ICO first as the universal fallback; browsers that understand SVG
        prefer it and get the scalable, theme-aware mark instead. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} · Blog`}
      href="/rss.xml"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical.href} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL('/portrait.jpg', Astro.site).href} />
    <meta property="og:image:alt" content={`Portrait of ${site.name}`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={new URL('/portrait.jpg', Astro.site).href} />

    <meta name="generator" content={Astro.generator} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    {/* Applies the stored theme before first paint so there is no flash. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* Storage unavailable; fall back to the OS preference. */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      backdrop && (
        <div class="page-backdrop" aria-hidden="true">
          <CellGraph />
        </div>
      )
    }
    <Header />
    <main id="main">
      <div class:list={['wrap', wide && 'wrap--wide']}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Fixed rather than absolute, so it costs no layout and cannot introduce a
     horizontal scrollbar the way a 100vw element does. Masked so it fades out
     well before the text starts competing with it. */
  .page-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    /* Blobs are drawn wider than the viewport by design; clip them so no
       browser can turn that into a horizontal scrollbar. */
    overflow: hidden;
    color: var(--accent);
    opacity: 0.55;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 18%, transparent 58%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 18%, transparent 58%);
  }

  :global(:root[data-theme='dark']) .page-backdrop {
    opacity: 0.4;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .page-backdrop {
      opacity: 0.4;
    }
  }

  /* Content sits above the wallpaper. */
  body > :global(main),
  body > :global(footer) {
    position: relative;
    z-index: 1;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    /* Must beat the sticky header's z-index: 20, or the focused link is
       painted behind it and Tab appears to do nothing (WCAG 2.4.7). */
    z-index: 30;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 0.5rem 0.9rem;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
