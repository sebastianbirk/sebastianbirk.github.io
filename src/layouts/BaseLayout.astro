---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, socials } from '../data/site';
import '../styles/global.css';

interface Props {
  /** Page title. The site name is appended automatically. */
  title?: string;
  description?: string;
  /** Widen the content column (used by Publications and Software). */
  wide?: boolean;
  /** Emitted as og:type; use "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search results and drop its canonical claim. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  wide = false,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Structured data so search engines and Scholar-adjacent crawlers can connect
// this page to the same person as the linked profiles.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  affiliation: { '@type': 'Organization', name: site.affiliation },
  url: canonical.origin,
  email: `mailto:${site.email}`,
  sameAs: socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Blog`}
      href="/rss.xml"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical.href} />}
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />

    <meta name="generator" content={Astro.generator} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    {/* Applies the stored theme before first paint so there is no flash. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* Storage unavailable — fall back to the OS preference. */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <div class:list={['wrap', wide && 'wrap--wide']}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 0.5rem 0.9rem;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
