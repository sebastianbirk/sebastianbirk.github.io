---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { cvSections, cvPdf } from '../data/cv';
import { site } from '../data/site';
import { publicationsByDate } from '../data/publications';

// Derived from the publication list so the two can never drift apart.
const plural = (n: number, one: string, many = `${one}s`) =>
  `${n} ${n === 1 ? one : many}`;

const parts = [
  ['journal', 'journal article'],
  ['preprint', 'preprint'],
  ['workshop', 'workshop paper'],
  ['abstract', 'conference abstract'],
] as const;

const summary = parts
  .map(([type, noun]) => [publicationsByDate.filter((p) => p.type === type).length, noun] as const)
  .filter(([n]) => n > 0)
  .map(([n, noun]) => plural(n, noun));

const summaryText =
  summary.length > 1
    ? `${summary.slice(0, -1).join(', ')} and ${summary[summary.length - 1]}`
    : (summary[0] ?? 'none listed');
---

<BaseLayout
  title="CV"
  description={`Curriculum vitae of ${site.name}, ${site.role} at the ${site.affiliation}.`}
>
  <div class="page-header">
    <h1>Curriculum vitae</h1>
    <p>{site.role} · {site.affiliation} · {site.location}</p>
    {
      cvPdf && (
        <p class="cv__download">
          <a href={cvPdf} download>
            Download PDF
          </a>
        </p>
      )
    }
  </div>

  {
    cvSections.map((section) => (
      <section class="section">
        <h2 class="section__label">{section.heading}</h2>
        <ol class="cv-list">
          {section.entries.map((entry) => (
            <li class="cv-entry">
              <div class="cv-entry__period">{entry.period ?? ''}</div>
              <div class="cv-entry__body">
                <h3 class="cv-entry__title">{entry.title}</h3>
                <p class="cv-entry__org">
                  {entry.organization}
                  {entry.location && <span class="cv-entry__loc">{entry.location}</span>}
                </p>
                {entry.details && (
                  <ul class="cv-entry__details">
                    {entry.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <section class="section">
    <h2 class="section__label">
      Publications
      <a href="/publications/">Full list →</a>
    </h2>
    <p class="cv-summary">
      {summaryText}, including first-authored work in <em>Nature Genetics</em>.
    </p>
  </section>

  <section class="section">
    <h2 class="section__label">Contact</h2>
    <SocialLinks labelled />
  </section>
</BaseLayout>

<style>
  .cv__download {
    margin-top: 1rem;
  }

  .cv__download a {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 0.4rem 0.9rem;
  }

  .cv__download a:hover {
    border-color: var(--accent);
  }

  .cv-list {
    list-style: none;
    padding: 0;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--border);
  }

  .cv-entry:last-child {
    border-bottom: 0;
  }

  .cv-entry__period {
    font-size: 0.85rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }

  .cv-entry__title {
    font-size: 1.02rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .cv-entry__flag {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9a3412;
    background: #fef3c7;
    border-radius: 3px;
    padding: 0.1rem 0.35rem;
  }

  .cv-entry__org {
    margin-top: 0.15rem;
    font-size: 0.925rem;
    color: var(--text-muted);
  }

  .cv-entry__loc::before {
    content: '·';
    margin-inline: 0.4rem;
    color: var(--text-faint);
  }

  .cv-entry__details {
    margin-top: 0.5rem;
    padding-left: 1.05rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .cv-entry__details li + li {
    margin-top: 0.2rem;
  }

  .cv-summary {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 34rem) {
    .cv-entry {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
