---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import { publicationsByDate } from '../data/publications';
import { projects } from '../data/projects';
import { fetchRepoStats, repoSlug, STAR_DISPLAY_THRESHOLD } from '../lib/github';
import { newsByDate } from '../data/news';

const selected = publicationsByDate.filter((p) => p.selected);
const featured = projects.filter((p) => p.selected);
const stats = await fetchRepoStats(
  featured.map((p) => repoSlug(p.links.code)).filter((s): s is string => Boolean(s)),
);
const recentNews = newsByDate.slice(0, 5);

const interests = [
  '🧬 Generative & foundation models for biology',
  '🔬 Spatial transcriptomics & single-cell genomics',
  '🧠 Representation learning & self-supervised learning',
  '🕸️ Graph machine learning',
  '⚙️ Scalable ML systems & scientific software',
];

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout backdrop>
  <section class="hero">
    <div class="hero__panel">
      <div class="hero__intro">
        <div class="hero__identity">
          <p class="hero__kicker">{site.tagline}</p>
          <h1>{site.name}</h1>
          <p class="hero__role">
            {site.role} · {site.affiliation}{' '}
            {site.roleFrom && <span class="hero__from">({site.roleFrom})</span>}
          </p>
        </div>
        <img
          class="hero__portrait"
          src="/portrait.jpg"
          width="320"
          height="320"
          alt={`Portrait of ${site.name}`}
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="hero__bio stack">
      <p class="lede">
        I build machine learning systems for spatial biology — the models, and
        the infrastructure that makes them usable.
      </p>
      <p>
        Two of them are NicheCompass, published in <em>Nature Genetics</em>, and
        TERRA. I led both, and both are open source.
      </p>
      <p>
        My background is half research, half engineering: a doctorate at
        Helmholtz Munich and the Technical University of Munich, and seven years
        in data science consulting — the last five building production ML
        platforms on Azure and Databricks for pharma, latterly alongside the PhD.
        I still consult. I care about work that survives contact with real data
        and real users.
      </p>
      <p>
        Always happy to hear from people working at the intersection of AI and
        biology.
      </p>
    </div>

    <ul class="hero__interests">
      {interests.map((item) => <li>{item}</li>)}
    </ul>

    <div class="hero__links">
      <SocialLinks labelled />
    </div>
  </section>

  <section class="now">
    <p class="now__label">Currently</p>
    <p class="now__text">
      Agentic systems for spatial genomics — bringing histology, spatial and
      single-cell omics, clinical data and knowledge graphs into a single
      multimodal analysis loop.
    </p>
  </section>

  <section class="section">
    <h2 class="section__label">
      Software{' '}
      <a href="/software/">All software →</a>
    </h2>
    <ul class="tools">
      {
        featured.map((project) => (
          <li class="tool">
            <span class="tool__head">
              <a class="tool__name" href={project.links.code ?? '/software/'}>
                {project.name}
              </a>
              {(() => {
                const st = stats.get(repoSlug(project.links.code) ?? '');
                return st && st.stars >= STAR_DISPLAY_THRESHOLD ? (
                  <span class="tool__stars">★ {st.stars.toLocaleString('en-GB')}</span>
                ) : null;
              })()}
            </span>
            <p class="tool__desc">{project.description}</p>
            {project.role && <p class="tool__role">{project.role}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2 class="section__label">
      Selected publications{' '}
      <a href="/publications/">All publications →</a>
    </h2>
    {selected.map((pub) => <PublicationEntry pub={pub} />)}
  </section>

  <section class="section">
    <h2 class="section__label">News</h2>
    <ul class="news">
      {
        recentNews.map((item) => (
          <li class="news__item">
            <time class="news__date" datetime={item.date}>
              {dateFormat.format(new Date(item.date))}
            </time>
            <span class="news__text">
              {item.href ? <a href={item.href}>{item.text}</a> : item.text}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero__panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--panel-from) 88%, transparent),
      color-mix(in srgb, var(--panel-to) 78%, transparent) 70%
    );
    backdrop-filter: blur(3px);
    box-shadow: var(--shadow-sm);
    padding: 1.9rem 2rem;
    margin-bottom: 2rem;
  }

  .hero__intro {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .hero__identity {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero__portrait {
    flex: 0 0 auto;
    width: 8.75rem;
    height: 8.75rem;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--bg);
    box-shadow:
      0 0 0 2px var(--accent),
      var(--shadow-md);
  }

  .hero__kicker {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .hero h1 {
    margin-bottom: 0.3rem;
  }

  .hero__role {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .hero__from {
    color: var(--text-faint);
  }

  .hero__bio {
    max-width: 40rem;
  }

  .hero__interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .hero__interests li {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.2rem 0.75rem;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .hero__interests li:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .hero__links {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  /* `.section + .section` in global.css does not cover the hero. */
  .hero + .section,
  .hero + .now {
    margin-top: 3.5rem;
  }

  .now {
    margin-top: 3.5rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--accent);
    border-radius: 12px;
    background: var(--accent-subtle);
  }

  .now__label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .now__text {
    font-size: 1rem;
    color: var(--text);
  }

  /* The callout already provides the separation the section rule would add. */
  .now + .section {
    margin-top: 2.5rem;
  }

  .tools {
    display: grid;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
  }

  .tool {
    position: relative;
    padding-left: 0.9rem;
  }

  .tool::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35rem;
    bottom: 0.2rem;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(var(--accent), var(--accent-2));
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .tool:hover::before {
    opacity: 1;
  }

  .tool__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .tool__stars {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
  }

  .tool__name {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
  }

  .tool__desc {
    margin-top: 0.25rem;
    font-size: 0.925rem;
    color: var(--text-muted);
  }

  .tool__role {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .news {
    list-style: none;
    padding: 0;
  }

  .news__item {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding-block: 0.6rem;
    padding-left: 0.75rem;
    border-bottom: 1px solid var(--border);
    border-radius: 6px;
    transition: background 0.18s ease;
  }

  .news__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    border-radius: 2px;
    background: var(--accent);
    transform: translateY(-50%);
    transition: height 0.2s ease;
  }

  .news__item:hover::before {
    height: 60%;
  }

  .news__item:last-child {
    border-bottom: 0;
  }

  .news__date {
    font-size: 0.8rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }

  .news__text {
    font-size: 0.925rem;
  }

  .news__text a {
    text-decoration: none;
    /* Derived from the link colour so the affordance is not colour-alone. */
    border-bottom: 1px solid color-mix(in srgb, currentColor 45%, transparent);
  }

  .news__text a:hover {
    border-bottom-color: currentColor;
  }

  @media (max-width: 34rem) {
    .hero__panel {
      padding: 1.4rem 1.25rem;
      border-radius: 14px;
    }

    .hero__intro {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.1rem;
    }

    .hero__portrait {
      width: 7rem;
      height: 7rem;
    }
  }

  @media (max-width: 30rem) {
    .news__item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
