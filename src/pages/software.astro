---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { fetchRepoStats, repoSlug, STAR_DISPLAY_THRESHOLD } from '../lib/github';

// Resolved during the build, so the figures are current on every deploy and
// no stale number is ever committed to the repo.
const stats = await fetchRepoStats(
  projects.map((p) => repoSlug(p.links.code)).filter((s): s is string => Boolean(s)),
);

const linkLabels: Record<string, string> = {
  code: 'Repository',
  docs: 'Documentation',
  paper: 'Paper',
};
---

<BaseLayout
  title="Software"
  description="Open-source tools for spatial and single-cell biology by Sebastian Birk: NicheCompass, TERRA, SQUINT, MintFlow and G2T."
  wide
>
  <div class="page-header">
    <h1>Software</h1>
    <p>
      Five open-source packages from the papers below — install them, or read the
      code. Built with the Lotfollahi Lab.
    </p>
  </div>

  <div class="projects">
    {
      projects.map((project) => (
        <article class="project">
          <div class="project__head">
            <h2 class="project__name">{project.name}</h2>
            {project.role && <span class="project__role">{project.role}</span>}
            {(() => {
              const st = stats.get(repoSlug(project.links.code) ?? '');
              return st && st.stars >= STAR_DISPLAY_THRESHOLD ? (
                <span class="project__stars" title={`${st.stars} GitHub stars`}>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
                  </svg>
                  {st.stars.toLocaleString('en-GB')}
                </span>
              ) : null;
            })()}
          </div>

          <p class="project__desc">{project.description}</p>

          <ul class="project__tags">
            {project.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>

          <p class="project__links">
            {Object.entries(project.links)
              .filter(([, href]) => Boolean(href))
              .map(([key, href]) => (
                <a href={href}>{linkLabels[key] ?? key}</a>
              ))}
          </p>
        </article>
      ))
    }
  </div>

  <section class="section consulting">
    <h2 class="section__label">Consulting</h2>
    <p>
      Alongside research I take on a small number of consulting engagements —
      machine learning for target discovery, and getting research models into
      production. Currently working with GSK.
    </p>
  </section>
</BaseLayout>

<style>
  .consulting {
    margin-top: 3.5rem;
    max-width: 46rem;
  }

  .consulting p {
    color: var(--text-muted);
  }

  .projects {
    display: grid;
    gap: 1.25rem;
  }

  .project {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.35rem 1.5rem;
    background: var(--bg);
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .project::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(var(--accent), var(--accent-2));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.25s ease;
  }

  .project:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .project:hover::before {
    transform: scaleY(1);
  }

  .project:hover .project__name {
    color: var(--accent);
  }

  .project__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.85rem;
  }

  .project__name {
    font-size: 1.2rem;
    transition: color 0.18s ease;
  }

  .project__role {
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .project__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    margin-left: auto;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.1rem 0.5rem;
  }

  .project__stars svg {
    width: 0.78rem;
    height: 0.78rem;
    fill: currentColor;
  }

  .project__desc {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 46rem;
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin-top: 0.85rem;
  }

  .project__tags li {
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1rem 0.45rem;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
  }

  .project__links a {
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
  }

  .project__links a:hover {
    text-decoration: underline;
  }
</style>
